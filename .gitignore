# =========================================================
# .gitignore completo para projetos C/C++
# Cobre Windows, Linux, macOS, IDEs e sistemas de build
# =========================================================

# ---------- Objetos e binários compilados ----------
*.o
*.obj
*.lo
*.slo
*.elf
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# ---------- Bibliotecas ----------
*.a
*.la
*.lai
*.lib
*.so
*.so.*
*.dylib
*.dll

# ---------- Arquivos de depuração ----------
*.dSYM/
*.su
*.idb
*.pdb
*.ilk
*.map
*.exp

# ---------- Precompilados / cache ----------
*.gch
*.pch
*.pchi

# ---------- Arquivos gerados por compiladores ----------
*.d
*.dep
*.mod
*.smod

# ---------- Kernel / módulos (Linux) ----------
*.ko
*.ko.cmd
*.mod.c
Module.symvers
modules.order

# ---------- CMake ----------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
build/
build*/
out/

# ---------- Make ----------
Makefile
!Makefile.am
!Makefile.in
.depend

# ---------- Autotools ----------
autom4te.cache/
aclocal.m4
config.log
config.status
configure
Makefile.in
libtool
stamp-h1

# ---------- Ninja ----------
.ninja_deps
.ninja_log
build.ninja

# ---------- Conan / vcpkg ----------
conaninfo.txt
conanbuildinfo.*
conan.lock
vcpkg_installed/

# ---------- Qt ----------
*.pro.user
*.pro.user.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
Makefile.Debug
Makefile.Release

# =========================================================
# Sistemas Operacionais
# =========================================================

# ---------- Windows ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ---------- Linux ----------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =========================================================
# IDEs e Editores
# =========================================================

# ---------- Visual Studio Code ----------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ---------- Visual Studio ----------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
Debug/
Release/
x64/
x86/
[Bb]in/
[Oo]bj/
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# ---------- CLion / JetBrains ----------
.idea/
cmake-build-*/

# ---------- Eclipse / CDT ----------
.metadata
.settings/
.cproject
.project
.autotools
.pydevproject

# ---------- Code::Blocks ----------
*.cbp
*.layout
*.depend

# ---------- Xcode ----------
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# ---------- Vim ----------
*.swp
*.swo
*.swn
Session.vim
.netrwhist
tags

# ---------- Emacs ----------
*~
\#*\#
.\#*

# ---------- Sublime Text ----------
*.sublime-workspace
*.sublime-project

# =========================================================
# Testes / Cobertura / Análise
# =========================================================
*.gcno
*.gcda
*.gcov
coverage/
*.lcov
*.profraw
*.profdata
callgrind.out.*
massif.out.*
*.log
*.tlog
core
core.*
vgcore.*

# =========================================================
# Diversos
# =========================================================
*.bak
*.tmp
*.temp
*.orig
*.rej
*.diff
*.patch
compile_flags.txt
.cache/